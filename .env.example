# 复制本文件为 .env 并填入真实值（.env 不要提交 git）

# ---------- LLM（生成回答）----------
# 云端 API 示例（DeepSeek）：
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 本地 LM Studio 则改成：
# LLM_API_KEY=lm-studio
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=qwen2.5-7b-instruct        # 填 LM Studio 里显示的标识

# 轻量模型（可选）：问题改写、笔记压缩这两个辅助调用用它，省延迟省费用；
# 不填则回落 LLM_MODEL。网关有 mini 档就填 mini 档。
# LLM_MODEL_LIGHT=gpt-5.4-mini

# ---------- Embedding（检索用）----------
# 方案A local：本地 sentence-transformers，首次需联网下载 bge-small-zh (~100MB)
# 方案B api：走 OpenAI 兼容接口（LM Studio 需先加载一个 embedding 模型）
EMBED_BACKEND=api
EMBED_MODEL=text-embedding-bge-m3      # 填 LM Studio 里显示的标识
EMBED_BASE_URL=http://localhost:1234/v1
EMBED_API_KEY=lm-studio
# 注意：换 embedding 模型/后端后必须重跑 python ingest.py --rebuild 全量重建
# （增量模式按文件内容 hash 判断变更，换模型时内容没变会直接跳过，库里仍是旧向量）

# 方案A 需要的镜像加速（仅 EMBED_BACKEND=local 时有用）
# HF_ENDPOINT=https://hf-mirror.com

# ---------- 重排（可选，显著提升检索质量）----------
# 首次运行自动下载 BAAI/bge-reranker-base（约 1.1GB，走 hf-mirror）
# 设为 off 可禁用，检索自动降级为混合召回排序
# RERANK_MODEL=BAAI/bge-reranker-base

# ---------- 浙大百事通（s.zju.edu.cn）实时兜底 ----------
# RAG 无命中/低分命中时，实时检索全校常见问题 + 校园资讯补进回答。
# 校内网络不可达 s.zju.edu.cn 时可设 off 关闭（默认 on）。
# BST_FALLBACK=on

# ---------- 登录认证 ----------
# cookie 签名密钥（必填）：python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=
# 允许注册的邮箱后缀（逗号分隔）
ALLOWED_EMAIL_DOMAINS=zju.edu.cn
# 管理员邮箱（逗号分隔）：名单里的邮箱正常注册后自动获得管理页；
# 老账号加进名单后，下次登录时自动提升。只提升不降级，撤销请在管理页操作。
# 这里只填邮箱不填密码——密码由本人注册时设定。
ADMIN_EMAILS=
# 登录保持天数
SESSION_DAYS=7
# 验证码邮件 SMTP；全部留空 = 开发模式（验证码打印到服务器控制台）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
