# 测试环境必须使用独立密钥、用户库、知识库、向量库和 Compose 项目名。
COMPOSE_PROJECT_NAME=mentor-agent-staging
IMAGE_TAG=replace-me-with-git-sha
APP_PORT=8502

LLM_API_KEY=replace-me
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_MODEL_LIGHT=replace-me-with-light-model

EMBED_BACKEND=local
EMBED_MODEL=BAAI/bge-small-zh-v1.5
RERANK_MODEL=BAAI/bge-reranker-base
HF_ENDPOINT=https://hf-mirror.com

AUTH_SECRET=replace-me-with-an-independent-secret
ALLOWED_EMAIL_DOMAINS=zju.edu.cn
ADMIN_EMAILS=replace-me@zju.edu.cn
SESSION_DAYS=1

SMTP_HOST=replace-me
SMTP_PORT=465
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=replace-me
