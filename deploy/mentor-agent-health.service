[Unit]
Description=Mentor Agent local health check
After=mentor-agent.service mentor-agent-backup.service

[Service]
Type=oneshot
User=txc
Group=txc
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/mentor-agent/ops.env
ExecStart=/usr/bin/python3 /usr/local/libexec/mentor-agent/ops_health_check.py
TimeoutStartSec=15s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
