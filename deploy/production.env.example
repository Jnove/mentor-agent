# 复制到生产部署目录的 .env，替换所有占位值后执行 deploy_preflight.py。
COMPOSE_PROJECT_NAME=mentor-agent-production
IMAGE_TAG=replace-me-with-git-sha
APP_PORT=8501

LLM_API_KEY=replace-me
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_MODEL_LIGHT=replace-me-with-light-model

EMBED_BACKEND=local
EMBED_MODEL=BAAI/bge-small-zh-v1.5
RERANK_MODEL=BAAI/bge-reranker-base
HF_ENDPOINT=https://hf-mirror.com

AUTH_SECRET=replace-me-with-64-hex-chars
ALLOWED_EMAIL_DOMAINS=zju.edu.cn
ADMIN_EMAILS=replace-me@zju.edu.cn
SESSION_DAYS=7

SMTP_HOST=replace-me
SMTP_PORT=465
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=replace-me
