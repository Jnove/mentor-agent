# 安装为 /etc/mentor-agent/ops.env；不应在这里放 API、SMTP 或证书私钥。
# 若加入告警 webhook 等密钥，请将文件改为 root:root 0600。
# 修改备份目录或锁路径时，还必须同步修改 backup.service 的 ReadWritePaths。
MENTOR_SERVICE=mentor-agent.service
MENTOR_ROOT=/opt/mentor-agent-production
MENTOR_BACKUP_DIR=/srv/mentor-backups
MENTOR_BACKUP_SCRIPT=/usr/local/libexec/mentor-agent/ops_backup.py
MENTOR_BACKUP_LOCK=/run/lock/mentor-agent-backup.lock
MENTOR_PYTHON=/usr/bin/python3
MENTOR_RUN_AS_USER=txc
MENTOR_SYSTEMCTL=/usr/bin/systemctl
MENTOR_RUNUSER=/usr/sbin/runuser

MENTOR_HEALTH_URL=http://127.0.0.1:8501/_stcore/health
MENTOR_HEALTH_TIMEOUT=5
MENTOR_HEALTH_EXPECT=ok

MENTOR_CERT_FILE=/etc/caddy/certs/mentor.zjuxlab.com.fullchain.pem
MENTOR_CERT_WARN_DAYS=30
MENTOR_OPENSSL=/usr/bin/openssl
